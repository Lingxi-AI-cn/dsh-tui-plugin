{
  "name": "@lingxi-ai-cn/dsh-tui",
  "description": "Post-install native terminal UI bundle for DeepSeek Harness",
  "version": "0.1.0-rc.9",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
